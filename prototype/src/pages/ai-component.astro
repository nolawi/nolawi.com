---
import { getEntry, render } from 'astro:content';
import Feature from '../layouts/Feature.astro';
import siteContent from '../../../content/site.json';
import { renderBody, tags } from '../../../scripts/content.js';
import { codePen } from '../../../scripts/publishing.js';

const entry = await getEntry('features', 'ai-component');
if (!entry) throw new Error('The AI feature Markdown entry is missing.');

const { Content } = await render(entry);
const { title, description, demo, afterDemo } = entry.data;
---
<Feature {title} {description} path="ai-component.html">
  <Fragment set:html={tags(entry.data, siteContent.topics)} />
  <div class="prose"><Content /></div>
  <Fragment set:html={codePen(demo.id, demo.title, demo.height)} />
  <div class="prose post-close" set:html={renderBody(afterDemo)}></div>
</Feature>
