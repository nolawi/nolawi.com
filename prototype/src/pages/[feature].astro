---
import { getCollection } from 'astro:content';
import Feature from '../layouts/Feature.astro';
import siteContent from '../../../content/site.json';
import { renderBody, tags } from '../../../scripts/content.js';
import { featurePath } from '../../../scripts/markdown-feature.js';
import { renderDesignProjects, renderFeatureDemos } from '../../../scripts/publishing.js';

export async function getStaticPaths() {
  const entries = await getCollection('features');
  return entries.map(entry => {
    const path = featurePath(entry.id);
    return { params: { feature: path.slice(0, -'.html'.length) }, props: { entry, path } };
  });
}

const { entry, path } = Astro.props;
const { title, description, demos, afterDemo, date } = entry.data;
---
<Feature {title} {description} {path} {date}>
  <Fragment set:html={tags(entry.data, siteContent.topics)} />
  {date && <p><time datetime={date}>{date}</time></p>}
  <div class="prose" set:html={renderBody(entry.body)}></div>
  <Fragment set:html={renderFeatureDemos(entry.id, demos)} />
  {afterDemo?.trim() && <div class="prose post-close" set:html={renderBody(afterDemo)}></div>}
  {entry.id === 'atomic-design' && <Fragment set:html={renderDesignProjects(siteContent)} />}
</Feature>
